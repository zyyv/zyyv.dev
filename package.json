{
  "name": "zyyv.dev",
  "private": true,
  "description": "Chris' blog built with Nuxt and Vue.",
  "keywords": [
    "blog",
    "nuxt",
    "unocss",
    "vue"
  ],
  "homepage": "https://github.com/zyyv/zyyv.dev#readme",
  "bugs": {
    "url": "https://github.com/zyyv/zyyv.dev/issues"
  },
  "author": "Chris <https://github.com/zyyv>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyyv/zyyv.dev.git"
  },
  "type": "module",
  "imports": {
    "#nitro-output": {
      "types": "./worker/nitro-handler.d.ts",
      "default": "./.output/server/index.mjs"
    }
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "format": "oxfmt .",
    "typecheck": "nuxt typecheck",
    "check:photo-pagination": "node scripts/check-photo-pagination.mjs",
    "taze": "taze major -wIr",
    "upload:local-photos": "esno scripts/upload-local-photos.ts",
    "import:bookmarks": "esno scripts/import-bookmarks.ts"
  },
  "dependencies": {
    "@lhlyu/vue-virtual-waterfall": "^1.0.9",
    "@nuxt/content": "^3.16.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "better-sqlite3": "^13.0.3",
    "blurhash": "^2.0.5",
    "magic-color": "^2.2.5",
    "media-chrome": "^4.19.2",
    "nuxt": "^4.5.2",
    "octokit": "^5.0.5",
    "ripplable": "^0.3.0",
    "vgpu": "0.3.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@iconify-json/hugeicons": "^1.2.34",
    "@iconify-json/logos": "^1.2.13",
    "@iconify/utils": "^3.1.6",
    "@octokit/types": "^18.0.0",
    "@types/node": "^26.4.1",
    "@unocss/core": "^66.10.0",
    "@unocss/nuxt": "^66.10.0",
    "@unocss/preset-wind4": "^66.10.0",
    "esno": "^4.8.0",
    "exifr": "^7.1.3",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.1.0",
    "typescript": "6.0.3",
    "unocss": "^66.10.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.129.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.3.4"
}
