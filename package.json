{
  "name": "zyyv.dev",
  "private": true,
  "description": "Chris' blog built with Nuxt and Vue.",
  "keywords": [
    "blog",
    "nuxt",
    "unocss",
    "vue"
  ],
  "homepage": "https://github.com/zyyv/zyyv.dev#readme",
  "bugs": {
    "url": "https://github.com/zyyv/zyyv.dev/issues"
  },
  "author": "Chris <https://github.com/zyyv>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyyv/zyyv.dev.git"
  },
  "type": "module",
  "imports": {
    "#nitro-output": {
      "types": "./worker/nitro-handler.d.ts",
      "default": "./.output/server/index.mjs"
    }
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "format": "oxfmt .",
    "typecheck": "nuxt typecheck",
    "taze": "taze major -wIr",
    "upload:local-photos": "esno scripts/upload-local-photos.ts"
  },
  "dependencies": {
    "@lhlyu/vue-virtual-waterfall": "^1.0.9",
    "@nuxt/content": "^3.15.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "better-sqlite3": "^13.0.2",
    "blurhash": "^2.0.5",
    "dayjs": "^1.11.21",
    "nuxt": "^4.5.1",
    "octokit": "^5.0.5",
    "ripplable": "^0.3.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@iconify-json/hugeicons": "^1.2.32",
    "@iconify-json/logos": "^1.2.12",
    "@iconify/utils": "^3.1.4",
    "@octokit/types": "^17.0.0",
    "@types/node": "^26.1.2",
    "@unocss/core": "^66.7.5",
    "@unocss/nuxt": "^66.7.5",
    "@unocss/preset-wind4": "^66.7.5",
    "esno": "^4.8.0",
    "exifr": "^7.1.3",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.17.1",
    "typescript": "6.0.3",
    "unocss": "^66.7.5",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.118.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.20.0"
}
